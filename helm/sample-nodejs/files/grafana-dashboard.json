{
  "title": "sample-nodejs",
  "uid": "sample-nodejs",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "/my-app requests (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(root_access_total{namespace=~\"sample-nodejs.*\"}[5m])",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "CPU usage (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{namespace=~\"sample-nodejs.*\"}[5m])",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Resident memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{namespace=~\"sample-nodejs.*\"}",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Event loop lag (p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_p99_seconds{namespace=~\"sample-nodejs.*\"}",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Heap usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "expr": "nodejs_heap_size_used_bytes{namespace=~\"sample-nodejs.*\"}",
          "legendFormat": "{{pod}} used"
        },
        {
          "expr": "nodejs_heap_size_total_bytes{namespace=~\"sample-nodejs.*\"}",
          "legendFormat": "{{pod}} total"
        }
      ]
    }
  ]
}
